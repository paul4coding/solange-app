# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.superviseur
!.env.local.example
!.env.docker.example

# clés API à transmettre en privé — jamais dans git
CLES-API-PRIVE.txt

# sauvegardes et sources d'images — les photos utilisées par le site
# sont versionnées dans public/images/, ces copies sont redondantes
cloudinary-images-download/
cloudinary-images.zip
*.zip
salon images/
preview-images.html

# dossier source des photos du salon : contient aussi une capture d'un tableau
# comptable (noms de personnes + montants) qui ne doit jamais être publiée.
# Les photos réellement utilisées sont versionnées dans public/images/gallery/
image a remplacer/
*.bmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
