# ============================================================
#  Solange's Hair Braiding — Fichier de configuration
#
#  INSTRUCTIONS POUR LE DÉPLOIEMENT :
#  1. Renomme ce fichier en   .env.local
#  2. Remplis les infos MySQL de ton hébergeur + les valeurs ← À CHANGER
#  3. Colle les clés API reçues en privé (section CLÉS API ci-dessous)
#  4. Importe mysql-schema.sql PUIS mysql-seed.sql dans la base
#  5. npm install  →  npm run build  →  npm start
#  Voir le README pour le détail complet.
# ============================================================

# ── Base de données MySQL ────────────────────────────────────
# Renseigne les infos de TA base MySQL (fournies par l'hébergeur)
DB_HOST=localhost                              # ← À CHANGER si la DB n'est pas locale
DB_PORT=3306
DB_NAME=solange_hair                           # ← À CHANGER si besoin
DB_USER=solange                                # ← À CHANGER
DB_PASSWORD=ChangeMe_DbPassword123!            # ← À CHANGER

# ── Authentification Admin (accès /admin) ────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe_AdminPassword!         # ← À CHANGER
JWT_SECRET=ChangeMe_JwtSecret_32charsMinimum!  # ← À CHANGER (chaîne aléatoire longue)

# ── CLÉS API (transmises séparément en privé) ────────────────
# Colle ici les valeurs reçues en privé
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
PINTEREST_ACCESS_TOKEN=
GOOGLE_API_KEY=
GOOGLE_CX_ID=
