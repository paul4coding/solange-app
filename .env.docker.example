# ============================================================
#  Modèle de configuration Docker
#  Copier en .env puis remplir :  cp .env.docker.example .env
#  Ce fichier est lu par docker compose, pas par Next.js.
# ============================================================

# ── Base de données (créée automatiquement au premier démarrage) ──
DB_ROOT_PASSWORD=changer-ce-mot-de-passe-root
DB_NAME=solange_hair
DB_USER=solange
DB_PASSWORD=changer-ce-mot-de-passe

# ── Port d'écoute du site sur la machine hôte ──
APP_PORT=3000

# ── Espace admin ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changer-ce-mot-de-passe-admin
# Chaîne aléatoire d'au moins 32 caractères :
#   openssl rand -base64 48
JWT_SECRET=changer-cette-chaine-aleatoire-de-32-caracteres-minimum

# ── Cloudinary (stockage des photos) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Recherche d'images — optionnel ──
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
GOOGLE_API_KEY=
GOOGLE_CX_ID=

# ── Emails (Resend) ──
# EMAIL_FROM doit utiliser un domaine vérifié chez Resend, sinon les emails
# aux clientes ne partiront pas. onboarding@resend.dev ne fonctionne qu'en test.
RESEND_API_KEY=
EMAIL_FROM=Solange's Hair Braiding <contact@votre-domaine.com>
