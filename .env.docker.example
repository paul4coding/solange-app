# ============================================================
#  Configuration du déploiement
#
#    cp .env.docker.example .env
#
#  Puis remplir les 5 valeurs de la PARTIE 1 : c'est le strict
#  minimum pour que le site tourne. La PARTIE 2 est optionnelle.
# ============================================================


# ════════════════════════════════════════════════════════════
#  PARTIE 1 — OBLIGATOIRE
# ════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────
# Elle est créée et remplie automatiquement au premier démarrage.
# Ces mots de passe sont à inventer, ils ne sont demandés nulle part ailleurs.
DB_ROOT_PASSWORD=un-mot-de-passe-solide-a-inventer
DB_PASSWORD=un-autre-mot-de-passe-a-inventer

# ── Accès à l'espace d'administration ───────────────────────
# C'est avec ça que la gérante se connecte sur /admin
ADMIN_PASSWORD=le-mot-de-passe-de-la-gerante

# ── Clé de signature des sessions ───────────────────────────
# Une longue chaîne aléatoire, 32 caractères minimum. Pour en générer une :
#   openssl rand -base64 48
JWT_SECRET=coller-ici-une-longue-chaine-aleatoire

# ── HTTPS ou non ? ──────────────────────────────────────────
# Le site est servi en https:// (nom de domaine + certificat) → laisser true
# Le site est servi en http:// (adresse IP, réseau interne)   → mettre false
#
# Avec true en http://, la connexion admin semble réussir puis renvoie au
# formulaire au premier rechargement : le navigateur refuse le cookie.
COOKIE_SECURE=true


# ════════════════════════════════════════════════════════════
#  PARTIE 2 — OPTIONNEL
#  Le site fonctionne sans. À remplir plus tard si besoin.
# ════════════════════════════════════════════════════════════

# ── Envoi des emails (Resend) ───────────────────────────────
# Sans ces valeurs : les réservations et messages sont bien enregistrés et
# consultables dans l'admin, mais aucun email de confirmation n'est envoyé.
#
# ATTENTION : EMAIL_FROM doit utiliser un domaine vérifié dans le compte
# Resend. L'adresse de test onboarding@resend.dev n'envoie qu'au propriétaire
# du compte — les clientes ne recevront rien.
RESEND_API_KEY=
EMAIL_FROM=Solange's Hair Braiding <contact@votre-domaine.com>

# ── Cloudinary ──────────────────────────────────────────────
# Les 24 photos du salon sont déjà incluses et s'affichent sans ces clés.
# Elles ne servent qu'aux NOUVELLES photos ajoutées depuis l'admin.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Réglages avec une valeur par défaut ─────────────────────
# À ne changer que si nécessaire.
DB_NAME=solange_hair
DB_USER=solange
ADMIN_USERNAME=admin
APP_PORT=3000
